---
import DossierCard from './DossierCard.astro';
import SplitFlap from './SplitFlap.astro';

// The name is the display line now (TechText is on hold), so the hero's <h1> is
// the name and the positioning copy moves into the lede under the role board.
// Kept as tokens so the Real1 word-bounce still drives each word off one --i.
const name = ['Praise', 'Oga'];
---

<section class="hero" id="top">
  <div class="hero-inner">
    <div class="hero-content">
      <h1 class="hero-name">
        {
          name.map((word, i) => (
            <span class="word" style={`--i:${i}`}>
              {word}
            </span>
          ))
        }
      </h1>

      <div class="hero-role">
        <SplitFlap />
      </div>

      <p class="lede">
        I like taking ideas that start out vague and turning them into products
        that <em>actually work</em>, figuring out the interface, the systems
        behind it, and everything in between. I build across full-stack web, AI,
        and Web3, following the problem wherever it leads.
      </p>

      <div class="cta-row">
        <a class="btn btn-primary" href="/#work">View Case Studies</a>
        <a class="btn btn-secondary" href="/#contact">Let's Talk</a>
      </div>
    </div>

    <div class="hero-aside">
      <DossierCard />
    </div>
  </div>

  <div class="scroll-hint" aria-hidden="true">
    <span class="mono">Scroll</span>
    <span class="scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: 9.5rem 5rem;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-inner {
    width: 100%;
    max-width: var(--maxw);
    margin: 0 auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 4rem;
  }

  /* --- name ------------------------------------------------------------- */

  .hero-name {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.28em;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .word {
    display: inline-block;
    opacity: 0;
    transform: translateY(46px) rotate(3deg);
    animation: wordBounce 0.7s var(--ease-spring) forwards;
    animation-delay: calc(var(--i) * 80ms + 80ms);
  }

  /* Two softened bounces rather than one hard settle — reads calmer on a
     light surface than the original's single spring. */
  @keyframes wordBounce {
    0% {
      opacity: 0;
      transform: translateY(46px) rotate(3deg);
    }
    62% {
      opacity: 1;
      transform: translateY(-6px) rotate(-0.8deg);
    }
    100% {
      opacity: 1;
      transform: translateY(0) rotate(0);
    }
  }

  /* --- role board ------------------------------------------------------- */

  .hero-role {
    margin-top: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.7s var(--ease-out) forwards;
    animation-delay: 340ms;
  }

  /* --- lede ------------------------------------------------------------- */

  .lede {
    margin-top: 1.75rem;
    max-width: 46ch;
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.65;
    color: var(--ink-dim);
    opacity: 0;
    animation: fadeUp 0.7s var(--ease-out) forwards;
    animation-delay: 460ms;
  }

  .lede em {
    font-style: italic;
    font-weight: 600;
    color: var(--red);
  }

  /* --- ctas ------------------------------------------------------------- */

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
    opacity: 0;
    animation: fadeUp 0.7s var(--ease-out) forwards;
    animation-delay: 600ms;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --- aside ------------------------------------------------------------ */

  .hero-aside {
    opacity: 0;
    animation: fadeUp 0.9s var(--ease-out) forwards;
    animation-delay: 0.5s;
  }

  /* --- scroll hint ------------------------------------------------------ */

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .scroll-hint .mono {
    font-size: 0.6rem;
    letter-spacing: 0.3em;
  }

  .scroll-line {
    width: 1px;
    height: 46px;
    background: var(--red);
    transform-origin: top;
    animation: scrollPulse 1.8s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%,
    100% {
      transform: scaleY(1);
      opacity: 1;
    }
    50% {
      transform: scaleY(0.3);
      opacity: 0.35;
    }
  }

  /* --- responsive ------------------------------------------------------- */

  @media (max-width: 980px) {
    .hero {
      padding-block: 8rem 4rem;
      min-height: auto;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }

  @media (max-width: 900px) {
    .scroll-hint {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-name {
      column-gap: 0.22em;
    }

    .cta-row {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-row .btn {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word,
    .hero-role,
    .lede,
    .cta-row,
    .hero-aside {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
